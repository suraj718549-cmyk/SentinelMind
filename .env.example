# URL of a running Hindsight server (see README quick start).
# Leave unset / unreachable to automatically use the local fallback store.
HINDSIGHT_API_URL=http://localhost:8888

# Bank id used to isolate SentinelMind's memory from any other Hindsight bank
# on the same server.
HINDSIGHT_BANK_ID=sentinelmind-soc

# Optional: if set (with LLM_API_KEY), the agent's reasoning step
# (src/llm_reasoner.py) calls a real LLM for free-text analysis instead of
# the deterministic heuristic reasoner. Supported: "groq", "openai", "anthropic".
# Leave LLM_PROVIDER unset to use the heuristic reasoner (fully offline, no
# key required, used by default whenever this isn't set).
#
# If LLM_MODEL is left blank, a current default is used per provider:
#   groq      -> openai/gpt-oss-20b
#   anthropic -> claude-sonnet-4-5-20250929
#   openai    -> gpt-4o-mini
#
# Any failure at call time (bad key, no network, rate limit, malformed
# response) falls back to the heuristic reasoner for that call and logs why
# — it never crashes triage and never silently fabricates a verdict.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Memory Defense: minimum trust score (0-1) an item must reach before it is
# retained into Hindsight automatically. Anything below this is queued for
# human approval instead of being written. See docs/SECURITY.md.
MEMORY_DEFENSE_AUTO_RETAIN_THRESHOLD=0.6
